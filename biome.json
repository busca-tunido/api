{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**/*", "test/**/*", "prisma.config.ts", "prisma/**/*"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "globals": [
      "describe",
      "it",
      "test",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "expect",
      "vi"
    ],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noDuplicateParameters": "error",
        "noDuplicateClassMembers": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "error",
        "noParameterProperties": "off",
        "useImportType": "off"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      },
      "complexity": {
        "noExtraBooleanCast": "error"
      }
    }
  }
}
