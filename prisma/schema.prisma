datasource db {
  provider = "mongodb"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum Role {
  STUDENT
  LANDLORD
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  COMMUNITY_VERIFIED
  OFFICIALLY_VERIFIED
  REJECTED
}

enum GenderPreference {
  ANY
  FEMALE_ONLY
  MALE_ONLY
}

enum RoomType {
  SINGLE
  SHARED
  STUDIO
}

enum AmenityCategory {
  BASIC_UTILITY
  ROOM_FEATURE
  COMMON_AREA
  STUDY_WORK
  SAFETY_SECURITY
}

enum ReportReason {
  FRAUD_OR_SCAM
  INACCURATE_PRICE
  MISLEADING_PHOTOS
  HOUSE_RULES_VIOLATION
  PROPERTY_UNAVAILABLE
  INAPPROPRIATE_CONTENT
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED_AND_APPROVED
}

enum ProposalType {
  AMENITIES_UPDATE
  BASIC_INFO
  LOCATION_UPDATE
  FULL_UPDATE
}

enum StayDurationCategory {
  FEW_DAYS
  FEW_WEEKS
  ONE_SEMESTER
  ONE_YEAR
  MORE_THAN_A_YEAR
}

type GeoPoint {
  type        String   @default("Point")
  coordinates Float[]
}

type EmbeddedPensionImage {
  id           String   @default(cuid())
  url          String
  thumbnailUrl String
  caption      String?
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

type EmbeddedRoom {
  id                 String    @default(cuid())
  roomNumber         String?
  title              String
  description        String?
  type               String    @default("SINGLE")
  monthlyPrice       Int
  deposit            Int?
  hasPrivateBathroom Boolean   @default(false)
  totalBeds          Int       @default(1)
  availableBeds      Int       @default(1)
  isAvailable        Boolean   @default(true)
  images             String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())
  deletedAt          DateTime?
}

type EmbeddedNearbyUniversity {
  universityId   String  @db.ObjectId
  name           String
  shortName      String?
  distanceMeters Int
  walkingMinutes Int?
  transitMinutes Int?
}

model User {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  email              String            @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  role               Role              @default(STUDENT)
  isEmailVerified    Boolean           @default(false)
  universityId       String?           @db.ObjectId
  university         University?       @relation(fields: [universityId], references: [id], onDelete: SetNull)
  favoritePensionIds String[]          @db.ObjectId
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  managedPensions    Pension[]         @relation("LandlordPensions")
  submittedPensions  Pension[]         @relation("SubmittedPensions")
  reviews            Review[]
  reports            Report[]
  submittedProposals PensionProposal[] @relation("SubmittedProposals")
  reviewedProposals  PensionProposal[] @relation("ReviewedProposals")

  @@index([universityId])
  @@index([deletedAt])
  @@map("users")
}

model University {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  shortName    String?
  emailDomains String[]  @default([])
  city         String
  address      String
  latitude     Float
  longitude    Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  students User[]

  @@index([city])
  @@index([deletedAt])
  @@map("universities")
}

model Pension {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  slug         String    @unique
  title        String
  description  String
  address      String
  city         String
  neighborhood String
  latitude     Float
  longitude    Float
  location     GeoPoint?

  contactName     String?
  contactPhone    String?
  contactWhatsapp String?
  contactEmail    String?

  baseMonthlyPrice Int
  deposit          Int?
  currency         String @default("CLP")

  waterIncluded       Boolean @default(true)
  electricityIncluded Boolean @default(true)
  gasIncluded         Boolean @default(true)
  internetIncluded    Boolean @default(true)

  curfewTime       String?
  guestsAllowed    Boolean          @default(false)
  smokingAllowed   Boolean          @default(false)
  petsAllowed      Boolean          @default(false)
  genderPreference GenderPreference @default(ANY)
  quietHoursStart  String?
  quietHoursEnd    String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  ratingAverage      Float              @default(0)
  ratingCount        Int                @default(0)
  communityScore     Float              @default(0)
  isActive           Boolean            @default(true)

  landlordId String? @db.ObjectId
  landlord   User?   @relation("LandlordPensions", fields: [landlordId], references: [id], onDelete: SetNull)

  submittedById String? @db.ObjectId
  submittedBy   User?   @relation("SubmittedPensions", fields: [submittedById], references: [id], onDelete: SetNull)

  amenities          String[]                    @default([])
  rooms              EmbeddedRoom[]
  images             EmbeddedPensionImage[]
  nearbyUniversities EmbeddedNearbyUniversity[]

  reviews   Review[]
  reports   Report[]
  proposals PensionProposal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([city, neighborhood])
  @@index([baseMonthlyPrice])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("pensions")
}

model Amenity {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  slug      String          @unique
  name      String
  category  AmenityCategory @default(BASIC_UTILITY)
  iconKey   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("amenities")
}

model Review {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  pensionId            String                @db.ObjectId
  userId               String                @db.ObjectId
  overallRating        Int
  cleanlinessRating    Int?
  landlordRating       Int?
  quietnessRating      Int?
  wifiRating           Int?
  comment              String
  images               String[]              @default([])
  stayDurationCategory StayDurationCategory?
  stayStartDate        DateTime?
  stayEndDate          DateTime?
  exactStayDays        Int?
  isResidentVerified   Boolean               @default(false)
  isHidden             Boolean               @default(false)
  moderationReason     String?
  moderatedById        String?               @db.ObjectId
  helpfulUserIds       String[]              @db.ObjectId
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  pension Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pensionId, userId])
  @@index([pensionId])
  @@index([userId])
  @@index([isHidden])
  @@index([deletedAt])
  @@map("reviews")
}

model Report {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  pensionId       String       @db.ObjectId
  userId          String       @db.ObjectId
  reason          ReportReason
  description     String
  status          ReportStatus @default(PENDING)
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  pension Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pensionId])
  @@index([status])
  @@index([deletedAt])
  @@map("reports")
}

model PensionProposal {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  pensionId       String         @db.ObjectId
  submittedById   String         @db.ObjectId
  reviewedById    String?        @db.ObjectId
  type            ProposalType   @default(BASIC_INFO)
  status          ProposalStatus @default(PENDING)
  proposedChanges Json
  appliedChanges  Json?
  submissionNotes String?
  reviewNotes     String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?

  pension     Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)
  submittedBy User    @relation("SubmittedProposals", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  User?   @relation("ReviewedProposals", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([pensionId])
  @@index([status])
  @@map("pension_proposals")
}
