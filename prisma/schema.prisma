datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum VerificationStatus {
  UNVERIFIED
  COMMUNITY_VERIFIED
  OFFICIALLY_VERIFIED
  REJECTED
}

enum GenderPreference {
  ANY
  FEMALE_ONLY
  MALE_ONLY
}

enum RoomType {
  SINGLE
  SHARED
  STUDIO
}

enum StayDurationCategory {
  FEW_DAYS
  FEW_WEEKS
  ONE_SEMESTER
  ONE_YEAR
  MORE_THAN_A_YEAR
}

type GeoPoint {
  type        String   @default("Point")
  coordinates Float[]
}

type EmbeddedPensionImage {
  id           String   @default(cuid())
  url          String
  thumbnailUrl String
  caption      String?
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

type EmbeddedRoom {
  id                 String    @default(cuid())
  roomNumber         String?
  title              String
  description        String?
  type               String    @default("SINGLE")
  monthlyPrice       Int
  deposit            Int?
  hasPrivateBathroom Boolean   @default(false)
  totalBeds          Int       @default(1)
  availableBeds      Int       @default(1)
  isAvailable        Boolean   @default(true)
  isActive           Boolean   @default(true)
  images             String[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now())
  deletedAt          DateTime?
}

type EmbeddedNearbyUniversity {
  universityId   String
  name           String
  shortName      String?
  distanceMeters Int
  walkingMinutes Int?
  transitMinutes Int?
}

model Pension {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  slug         String    @unique
  title        String
  description  String
  address      String
  city         String
  neighborhood String
  latitude     Float
  longitude    Float
  location     GeoPoint?

  contactName     String?
  contactPhone    String?
  contactWhatsapp String?
  contactEmail    String?

  baseMonthlyPrice Int
  deposit          Int?
  currency         String @default("CLP")

  waterIncluded       Boolean @default(true)
  electricityIncluded Boolean @default(true)
  gasIncluded         Boolean @default(true)
  internetIncluded    Boolean @default(true)

  curfewTime       String?
  guestsAllowed    Boolean          @default(false)
  smokingAllowed   Boolean          @default(false)
  petsAllowed      Boolean          @default(false)
  genderPreference GenderPreference @default(ANY)
  quietHoursStart  String?
  quietHoursEnd    String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  ratingAverage      Float              @default(0)
  ratingCount        Int                @default(0)
  communityScore     Float              @default(0)
  isActive           Boolean            @default(true)

  landlordId    String?
  submittedById String?

  amenities          String[]                   @default([])
  rooms              EmbeddedRoom[]
  images             EmbeddedPensionImage[]
  nearbyUniversities EmbeddedNearbyUniversity[]

  reviews Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([city, neighborhood])
  @@index([baseMonthlyPrice])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([landlordId])
  @@index([deletedAt])
  @@map("pensions")
}

model Review {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  pensionId            String                @db.ObjectId
  userId               String
  overallRating        Int
  cleanlinessRating    Int?
  landlordRating       Int?
  quietnessRating      Int?
  wifiRating           Int?
  comment              String
  images               String[]              @default([])
  stayDurationCategory StayDurationCategory?
  stayStartDate        DateTime?
  stayEndDate          DateTime?
  exactStayDays        Int?
  isResidentVerified   Boolean               @default(false)
  isHidden             Boolean               @default(false)
  moderationReason     String?
  moderatedById        String?
  helpfulUserIds       String[]              @default([])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  pension Pension @relation(fields: [pensionId], references: [id], onDelete: Cascade)

  @@unique([pensionId, userId])
  @@index([pensionId])
  @@index([userId])
  @@index([isHidden])
  @@index([deletedAt])
  @@map("reviews")
}
